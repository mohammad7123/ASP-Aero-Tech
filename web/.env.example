# ─────────────────────────────────────────────────────────────────────────────
# ASP Aero Tech web — environment variables
# Copy to .env.local for development. On Vercel, add these under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the deployed site (canonical URLs, sitemap, Open Graph, JSON-LD).
# Falls back to Vercel's production domain, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Base URL of the existing ASP Aero Tech API server (artifacts/api-server),
# WITHOUT the trailing /api. Example: https://asp-aero-tech.replit.app
# When set, the site reads products, contact details, socials, careers and
# blog posts from the admin console, and the contact form saves inquiries
# into the same database. When unset, the site renders from src/content/*.
ASP_API_URL=

# How long (seconds) API-backed pages are cached before revalidating.
ASP_REVALIDATE_SECONDS=300
